{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/intro",
      "permanent": false
    },
    {
      "source": "/supermills-deck",
      "destination": "/supermills-deck/",
      "permanent": false
    },
    {
      "source": "/supermills-america-overview",
      "destination": "/supermills-deck/",
      "permanent": false
    },
    {
      "source": "/supermills-america-overview/",
      "destination": "/supermills-deck/",
      "permanent": false
    },
    {
      "source": "/supermills-america-overview/:path*",
      "destination": "/supermills-deck/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/intro",
      "destination": "/"
    },
    {
      "source": "/supermills-deck/",
      "destination": "/supermills-america-overview/slides"
    },
    {
      "source": "/supermills-deck/:path+",
      "destination": "/supermills-america-overview/:path+"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/supermills-deck/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
