{
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/intro", "permanent": false }
  ],
  "rewrites": [
    { "source": "/intro", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
